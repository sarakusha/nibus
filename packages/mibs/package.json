    "type": "git",
    "url": "https://github.com/sarakusha/nibus.git",
    "directory": "packages/mibs"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "fp-ts": "^2.16.11",
    "io-ts": "^2.2.22"
  },
  "scripts": {
    "build": "node ./scripts/generate-index.mjs && tsdown",
    "yalc:push": "pnpm run build && yalc push",
    "lint": "eslint index.ts",
    "lint:fix": "eslint --fix index.ts"
  },
  "gitHead": "876cd1a510a30b9b3a4b59c012dd707db5e695b8"
