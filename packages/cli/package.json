{
  "name": "@nibus/cli",
  "version": "6.0.7",
  "description": "Nata-Info NiBUS",
  "keywords": [
    "nata-info",
    "nibus",
    "sarakusha"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "service": "cross-env NODE_ENV=production DEBUG=nibus:*,-nibus:decoder pm2 --name=nibus.service start lib/service/daemon.js",
    "build": "tsdown",
    "compile": "cross-env NODE_ENV=development tsc",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/"
  },
  "bin": {
    "nibus": "build/index.cjs"
  },
  "author": "Andrei Sarakeev <avs@nata-info.ru>",
  "license": "MIT",
  "files": [
    "build",
    "!**/*.tsbuildinfo",
    "!**/*.spec.*",
    "CHANGELOG.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sarakusha/nibus.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/sarakusha/nibus/issues"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/lodash": "^4.17.24",
    "@types/progress": "^2.0.7",
    "@types/tail": "^2.2.3",
    "@types/yargs": "^17.0.35"
  },
  "dependencies": {
    "@nibus/core": "workspace:^",
    "@nibus/mibs": "workspace:^",
    "@nibus/service": "workspace:^",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "debug": "^4.4.3",
    "fp-ts": "^2.16.11",
    "io-ts": "^2.2.22",
    "lodash": "^4.18.1",
    "onetime": "^8.0.0",
    "pm2": "^7.0.1",
    "progress": "^2.0.3",
    "supports-color": "^10.2.2",
    "table-layout": "^4.1.1",
    "tail": "^2.2.6",
    "yargs": "^18.0.0"
  },
  "peerDependencies": {
    "debug": "^4.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/*.+[tj]sx?",
      "**/src/**/*.spec.+[tj]sx?"
    ]
  },
  "pkg": {
    "scripts": "lib/**/*.js",
    "assets": "assets/**"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "876cd1a510a30b9b3a4b59c012dd707db5e695b8"
}
