{
  "name": "@nibus/core",
  "version": "6.0.7",
  "description": "nibus.js client",
  "keywords": [
    "nata-info",
    "nibus",
    "sarakusha"
  ],
  "type": "module",
  "author": "Andrei Sarakeev <sarakusha@gmail.com>",
  "homepage": "https://github.com/sarakusha/nibus/packages/core#readme",
  "license": "MIT",
  "main": "build/index.cjs",
  "types": "./build/index.d.cts",
  "module": "build/index.mjs",
  "exports": {
    ".": {
      "require": "./build/index.cjs",
      "import": "./build/index.mjs",
      "types": "./build/index.d.cts"
    },
    "./sarp": {
      "require": "./build/sarp/index.cjs",
      "import": "./build/sarp/index.mjs",
      "types": "./build/sarp/index.d.cts"
    },
    "./session": {
      "require": "./build/session/index.cjs",
      "import": "./build/session/index.mjs",
      "types": "./build/session/index.d.cts"
    },
    "./session/*": {
      "require": "./build/session/*.cjs",
      "import": "./build/session/*.mjs",
      "types": "./build/session/*.d.cts"
    },
    "./*": {
      "require": "./build/*.cjs",
      "import": "./build/*.mjs",
      "types": "./build/*.d.cts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "session": [
        ",/build/sesssion/*",
        "./build/session/index.d.ts"
      ],
      "*": [
        "./build/*",
        "./build/index.d.ts"
      ]
    }
  },
  "files": [
    "build",
    "src",
    "!**/*.spec.*",
    "!**/*.tsbuildinfo",
    "EULA.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sarakusha/nibus.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsdown",
    "test": "jest src",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "typedoc": "typedoc",
    "yalc:push": "yalc push"
  },
  "bugs": {
    "url": "https://github.com/sarakusha/nibus/issues"
  },
  "devDependencies": {
    "@types/crc": "^4.0.0",
    "@types/debug": "^4.1.13",
    "@types/lodash": "^4.17.24",
    "@types/pump": "^1.1.3",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "typedoc": "^0.28.19"
  },
  "dependencies": {
    "@nibus/mibs": "workspace:^",
    "conf": "^15.1.0",
    "crc": "^4.3.2",
    "fast-xml-parser": "^5.8.0",
    "fp-ts": "^2.16.11",
    "iconv-lite": "^0.7.2",
    "intel-hex": "^0.2.0",
    "io-ts": "^2.2.22",
    "io-ts-types": "^0.5.19",
    "lodash": "^4.18.1",
    "monocle-ts": "^2.3.13",
    "newtype-ts": "^0.3.5",
    "printf": "^0.6.1",
    "pump": "^3.0.4",
    "reflect-metadata": "^0.2.2",
    "sax": "^1.6.0",
    "tiny-typed-emitter": "^2.1.0"
  },
  "peerDependencies": {
    "@nibus/mibs": "^6.0.7",
    "debug": "^4.3.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "876cd1a510a30b9b3a4b59c012dd707db5e695b8"
}
